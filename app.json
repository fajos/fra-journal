{
  "expo": {
    "name": "Reflective E-Journal",
    "slug": "e-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FAF7F2"
    },
    "updates": {
      "url": "https://u.expo.dev/cf324628-c896-4576-82b9-2bc0a446aa8f",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.fajostech.ejournal",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Reflective E-Journal to use Face ID to authenticate and protect your private journal entries."
      }
    },
    "android": {
      "package": "com.fajostech.ejournal",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Reflective E-Journal to use Face ID to authenticate and protect your private journal entries."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf324628-c896-4576-82b9-2bc0a446aa8f"
      }
    },
    "owner": "e-journal"
  }
}
